APP_NAME="Document Control System"
# ==== [ APP_ENV ] ====
# Set the value to "production" when the project
# is ready to be deployed. Set the value to "local"
# when the project is in development
APP_ENV=production
# ==== [ APP_KEY ] ====
# The key generated by the app. Generate the key using 
# The command below on the root directory of this project. 
# docker compose exec backend php artisan key:generate --show
APP_KEY=
# ==== [ APP_DEBUG ] ====
# Set the value to "false" when the project
# is ready to be deployed. Set the value to "true"
# when the project is in development
APP_DEBUG=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ==== [ MAIL_MAILER ] ====
# Replace the value with "resend" to enable
# mails to be sent through resend's API
# Replace the value with "log" to send 
# mail notification to the laravel.log file
# at storage/logs/laravel.log
MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# ==== [ MAIL_FROM_ADDRESS ] ====
# You may specify a custom email address using the company's domain 
# (e.g., dcs.mailbox@toyotasantarosa.com.ph). The email address itself 
# does not need to exist, but the domain (e.g., toyotasantarosa.com.ph) 
# must be valid and registered
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="DCS Mailbox"

# ==== [ RESEND_API_KEY ] ====
# The API key provided by Resend once an account was registered and a domain
# is added on the resend dashboard
RESEND_API_KEY=