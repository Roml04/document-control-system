# ==== [ APP_URL ] ====
# Base URL of the Laravel application, used for generating 
# absolute URLs in links, redirects, and notifications.
# Replace this with the IP of the machine where the container
# is hosted. (default: http://backend:8080)
APP_URL=http://backend:8080

MYSQL_DATABASE=dcs_backend
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

ONLYOFFICE_INTERNAL_URL=${APP_URL}
ONLYOFFICE_DOCS_INTERNAL_URL=http://onlyoffice

# ==== [ ONLYOFFICE_JWT_SECRET ] ====
# Generate using by running the command below on the terminal of the root directory of
# this project. 
# docker compose exec backend php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
ONLYOFFICE_JWT_SECRET=