# ==== [ APP_URL ] ====
# Base URL of the Laravel application, used for generating 
# absolute URLs in links, redirects, and notifications.
# Replace this with the IP of the machine where the container
# is hosted. (default: http://backend:8080)
APP_URL=http://backend:8080

MYSQL_DATABASE=dcs_backend
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

ONLYOFFICE_INTERNAL_URL=${APP_URL}
ONLYOFFICE_DOCS_INTERNAL_URL=http://onlyoffice

# ==== [ ONLYOFFICE_JWT_SECRET ] ====
# Generate using by running the command below on the terminal of the root directory of
# this project. 
# docker compose exec backend php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
ONLYOFFICE_JWT_SECRET=

# ==== [ FRONTEND_PATH & BACKEND_PATH ] ==== 
# Paths to the frontend and backend source code directories. These variables are intended 
# for development environments only.
# FRONTEND_PATH="../document-control-system-frontend"
# BACKEND_PATH="../document-control-system-backend"

# ==== [ COMPOSE_FILE ] ====
# Defines the production and development compose files to merge. this is inteded for development
# environments only. 
# COMPOSE_FILE=compose.yaml:compose.dev.yaml

# ==== [ COMPOSE_PROJECT_NAME ]
# The name used by Docker Compose to group and identify project resources. This variable is intended
# for development environments only.
# COMPOSE_PROJECT_NAME=dcs-dev

# ==== [ USER_ID & GROUP_ID ] ====
# The user ID and group ID of the host machine's WSL 2 setup. Uses the values as user ID and
# group ID in the backend container to avoid file permission issues. These variables are intended 
# for development environments only.
#$ USER_ID=
#$ GROUP_ID=